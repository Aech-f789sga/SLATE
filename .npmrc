# The repo pins esbuild ^0.25 as a devDependency while Vite 8 declares a
# peerOptional on ^0.27 || ^0.28. npm 7+ treats that as a hard conflict, so a
# clean `npm install` fails with ERESOLVE — which is how a Vercel build dies
# before it ever reaches `vite build`. The tree installs and builds fine; the
# disagreement is between version ranges, not between the packages.
legacy-peer-deps=true
